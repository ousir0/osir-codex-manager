[Unit]
Description=OSIR restricted Codex i18n HTTPS CONNECT relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wei
Group=wei
WorkingDirectory=/srv/osir/relay
ExecStart=/usr/bin/python3 /srv/osir/relay/osir_connect_relay.py --bind 127.0.0.1 --port 3128
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/osir/relay
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
