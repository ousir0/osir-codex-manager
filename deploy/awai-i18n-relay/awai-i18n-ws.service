[Unit]
Description=AWAI Codex i18n WebSocket tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wei
Group=wei
WorkingDirectory=/srv/awai/relay
ExecStart=/usr/bin/python3 /srv/awai/relay/awai_i18n_ws.py
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/awai/relay
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
